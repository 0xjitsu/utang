# Copy to .env.local to play against the deployed testnet contract.
# Remove VITE_CONTRACT_ID (or leave it empty) to run in PREVIEW mode with the in-browser mock.
VITE_NETWORK=testnet
# Demo build: 1 day = 1 minute (rules().demo_time = true). Main build (1 day = 24 h): utang-game.testnet
VITE_CONTRACT_ID=demo.utang-game.testnet
# Optional: override the JSON-RPC endpoint used for view calls and by the wallet selector.
# VITE_RPC_URL=https://test.rpc.fastnear.com
